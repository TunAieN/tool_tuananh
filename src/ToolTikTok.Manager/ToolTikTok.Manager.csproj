<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Keep runtime names stable for installer/updater compatibility. -->
    <AssemblyName>ToolTikTokManagerV13</AssemblyName>
    <RootNamespace>ToolTikTokManagerV13</RootNamespace>
    <Product>Tool TikTok Manager V13</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ToolTikTok.ico</ApplicationIcon>
    <OutputPath>..\..\dist_v13\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ToolTikTok.Contracts\ToolTikTok.Contracts.csproj" />
    <ProjectReference Include="..\ToolTikTok.Infrastructure\ToolTikTok.Infrastructure.csproj" />
    <ProjectReference Include="..\ToolTikTok.Automation\ToolTikTok.Automation.csproj" />
    <ProjectReference Include="..\ToolTikTok.UI\ToolTikTok.UI.csproj" />
    <ProjectReference Include="..\ToolTikTok.Worker\ToolTikTok.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\config\manager_worker_ipc.json" Link="manager_worker_ipc.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
